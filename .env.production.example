# Django
DJANGO_ENV=production
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=api.example.com
CORS_ALLOWED_ORIGINS=https://web.example.com
CSRF_TRUSTED_ORIGINS=https://api.example.com,https://web.example.com

# PostgreSQL
POSTGRES_DB=benim_depom
POSTGRES_USER=benim_depom
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis / Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
REDIS_CACHE_URL=redis://redis:6379/2

# FTP media storage
FTP_MEDIA_HOST=ftp.example.com
FTP_MEDIA_PORT=21
FTP_MEDIA_USERNAME=replace-me
FTP_MEDIA_PASSWORD=replace-me
FTP_MEDIA_REMOTE_ROOT=/api-media
FTP_MEDIA_PUBLIC_BASE_URL=https://media.example.com/api-media/
FTP_MEDIA_USE_TLS=true
FTP_MEDIA_PASSIVE_MODE=true
FTP_MEDIA_TIMEOUT_SECONDS=30

# White-image service
BULK_WHITE_IMAGE_SERVICE_URL=https://service.example.com/api/generate-from-image/
BULK_WHITE_IMAGE_SERVICE_TOKEN=replace-me
BULK_WHITE_IMAGE_SERVICE_RESULTS_URL=https://service.example.com/api/generation-results/{product_id}/
BULK_WHITE_IMAGE_SERVICE_TIMEOUT_SECONDS=120
BULK_WHITE_IMAGE_SERVICE_POLL_INTERVAL_SECONDS=10
BULK_WHITE_IMAGE_SERVICE_MAX_POLL_ATTEMPTS=60
BULK_WHITE_IMAGE_ALLOWED_IMAGE_HOSTS=media.example.com,service.example.com

# OpenAI
OPENAI_ENABLED=true
OPENAI_API_KEY=replace-me
OPENAI_TEXT_MODELS=gpt-5-mini
OPENAI_TEXT_TIMEOUT_SECONDS=60
OPENAI_TEXT_MAX_RETRIES_PER_MODEL=2
OPENAI_TEXT_RETRY_DELAY_SECONDS=1.5

# Firebase push notifications
FIREBASE_ENABLED=true
FIREBASE_SERVICE_ACCOUNT_FILE=/run/secrets/firebase-service-account.json

# SMTP email verification
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=465
EMAIL_USE_SSL=true
EMAIL_USE_TLS=false
EMAIL_HOST_USER=no-reply@example.com
EMAIL_HOST_PASSWORD=replace-me
DEFAULT_FROM_EMAIL=Benim Depom <no-reply@example.com>
EMAIL_TIMEOUT=15

# Hood credentials
HOOD_LOGIN=replace-me
HOOD_PASSWORD=replace-me