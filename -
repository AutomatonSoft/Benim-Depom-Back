openapi: 3.0.3
info:
  title: Benim Depom Backend API
  version: 1.0.0
  description: API for the seller mobile application and manager web panel. Operations
    are grouped by client and business domain.
paths:
  /api/schema/:
    get:
      operationId: schema_retrieve
      description: |-
        OpenApi3 schema for this API. Format can be selected via content negotiation.

        - YAML: application/vnd.oai.openapi
        - JSON: application/vnd.oai.openapi+json
      parameters:
      - in: query
        name: format
        schema:
          type: string
          enum:
          - json
          - yaml
      - in: query
        name: lang
        schema:
          type: string
          enum:
          - af
          - ar
          - ar-dz
          - ast
          - az
          - be
          - bg
          - bn
          - br
          - bs
          - ca
          - ckb
          - cs
          - cy
          - da
          - de
          - dsb
          - el
          - en
          - en-au
          - en-gb
          - eo
          - es
          - es-ar
          - es-co
          - es-mx
          - es-ni
          - es-ve
          - et
          - eu
          - fa
          - fi
          - fr
          - fy
          - ga
          - gd
          - gl
          - he
          - hi
          - hr
          - hsb
          - hu
          - hy
          - ia
          - id
          - ig
          - io
          - is
          - it
          - ja
          - ka
          - kab
          - kk
          - km
          - kn
          - ko
          - ky
          - lb
          - lt
          - lv
          - mk
          - ml
          - mn
          - mr
          - ms
          - my
          - nb
          - ne
          - nl
          - nn
          - os
          - pa
          - pl
          - pt
          - pt-br
          - ro
          - ru
          - sk
          - sl
          - sq
          - sr
          - sr-latn
          - sv
          - sw
          - ta
          - te
          - tg
          - th
          - tk
          - tr
          - tt
          - udm
          - ug
          - uk
          - ur
          - uz
          - vi
          - zh-hans
          - zh-hant
      tags:
      - schema
      security:
      - jwtAuth: []
      - {}
      responses:
        '200':
          content:
            application/vnd.oai.openapi:
              schema:
                type: object
                additionalProperties: {}
            application/yaml:
              schema:
                type: object
                additionalProperties: {}
            application/vnd.oai.openapi+json:
              schema:
                type: object
                additionalProperties: {}
            application/json:
              schema:
                type: object
                additionalProperties: {}
          description: ''
  /api/v1/auth/email/resend-verification/:
    post:
      operationId: v1_auth_email_resend_verification_create
      description: Sends a new six-digit email verification code.
      summary: Отправить email-код повторно
      tags:
      - Auth - Seller
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/EmailVerificationResendRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/EmailVerificationResendRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/EmailVerificationResendRequest'
        required: true
      security:
      - jwtAuth: []
      - {}
      responses:
        '202':
          content:
            application/json:
              schema:
                type: object
                additionalProperties: {}
          description: ''
  /api/v1/auth/email/verify/:
    post:
      operationId: v1_auth_email_verify_create
      description: Verifies the six-digit email code and returns JWT tokens.
      summary: Подтвердить email кодом
      tags:
      - Auth - Seller
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/EmailVerificationRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/EmailVerificationRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/EmailVerificationRequest'
        required: true
      security:
      - jwtAuth: []
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                type: object
                additionalProperties: {}
          description: ''
  /api/v1/auth/login/:
    post:
      operationId: v1_auth_login_create
      description: |-
        Takes a set of user credentials and returns an access and refresh JSON web
        token pair to prove the authentication of those credentials.
      summary: Войти по email и паролю
      tags:
      - Auth - Shared
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/AuthLoginRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/AuthLoginRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/AuthLoginRequest'
        required: true
      security:
      - {}
      responses:
        '200':
          description: No response body
  /api/v1/auth/logout/:
    post:
      operationId: v1_auth_logout_create
      summary: Выйти и отозвать refresh-токен
      tags:
      - Auth - Shared
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/AuthLogoutRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/AuthLogoutRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/AuthLogoutRequest'
        required: true
      security:
      - jwtAuth: []
      responses:
        '204':
          description: No response body
  /api/v1/auth/me/:
    get:
      operationId: v1_auth_me_retrieve
      summary: Получить свой профиль
      tags:
      - Auth - Seller
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/AuthProfile'
          description: ''
    patch:
      operationId: v1_auth_me_partial_update
      summary: Изменить свой профиль
      tags:
      - Auth - Seller
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PatchedAuthProfileRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/PatchedAuthProfileRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/PatchedAuthProfileRequest'
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/AuthProfile'
          description: ''
    delete:
      operationId: v1_auth_me_destroy
      description: Lets a seller delete their own account. Active marketplace listings
        are removed first; the account is disabled immediately and fully deleted after
        those jobs finish.
      summary: Удалить свой аккаунт
      tags:
      - Auth - Seller
      security:
      - jwtAuth: []
      responses:
        '202':
          description: No response body
        '204':
          description: No response body
  /api/v1/auth/me/language/:
    patch:
      operationId: v1_auth_me_language_partial_update
      description: 'Stores the seller''s interface language. Later notifications and
        pushes use this language: ru, en, de, or tr.'
      summary: Выбрать язык уведомлений
      tags:
      - Auth - Seller
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PatchedPreferredLanguageRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/PatchedPreferredLanguageRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/PatchedPreferredLanguageRequest'
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/AuthProfile'
          description: ''
  /api/v1/auth/password/change/:
    post:
      operationId: v1_auth_password_change_create
      description: Изменяет пароль авторизованного пользователя и отзывает все его
        refresh-токены.
      summary: Изменить пароль
      tags:
      - Auth - Shared
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/AuthPasswordChangeRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/AuthPasswordChangeRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/AuthPasswordChangeRequest'
        required: true
      security:
      - jwtAuth: []
      responses:
        '204':
          description: No response body
  /api/v1/auth/password/reset/complete/:
    post:
      operationId: v1_auth_password_reset_complete_create
      description: Устанавливает новый пароль по reset_token и отзывает все активные
        refresh-токены. После этого пользователь входит заново.
      summary: Установить новый пароль
      tags:
      - Auth - Shared
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/AuthPasswordResetCompleteRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/AuthPasswordResetCompleteRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/AuthPasswordResetCompleteRequest'
        required: true
      security:
      - jwtAuth: []
      - {}
      responses:
        '204':
          description: No response body
  /api/v1/auth/password/reset/request/:
    post:
      operationId: v1_auth_password_reset_request_create
      description: Отправляет шестизначный код сброса пароля на email. Ответ не раскрывает,
        зарегистрирован ли такой пользователь.
      summary: Запросить код для сброса пароля
      tags:
      - Auth - Shared
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/AuthPasswordResetRequestRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/AuthPasswordResetRequestRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/AuthPasswordResetRequestRequest'
        required: true
      security:
      - jwtAuth: []
      - {}
      responses:
        '202':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/AuthPasswordResetRequestResponse'
          description: ''
  /api/v1/auth/password/reset/verify/:
    post:
      operationId: v1_auth_password_reset_verify_create
      description: Проверяет шестизначный код и возвращает короткоживущий reset_token
        для установки нового пароля.
      summary: Проверить код сброса пароля
      tags:
      - Auth - Shared
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/AuthPasswordResetVerifyRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/AuthPasswordResetVerifyRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/AuthPasswordResetVerifyRequest'
        required: true
      security:
      - jwtAuth: []
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/AuthPasswordResetVerifyResponse'
          description: ''
  /api/v1/auth/refresh/:
    post:
      operationId: v1_auth_refresh_create
      description: |-
        Takes a refresh type JSON web token and returns an access type JSON web
        token if the refresh token is valid.
      summary: Обновить JWT-токены
      tags:
      - Auth - Shared
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/TokenRefreshRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/TokenRefreshRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/TokenRefreshRequest'
        required: true
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/TokenRefresh'
          description: ''
  /api/v1/auth/register/:
    post:
      operationId: v1_auth_register_create
      summary: Зарегистрировать продавца
      tags:
      - Auth - Seller
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/AuthRegisterRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/AuthRegisterRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/AuthRegisterRequest'
        required: true
      security:
      - jwtAuth: []
      - {}
      responses:
        '201':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/AuthRegister'
          description: ''
  /api/v1/catalog/otto/category-groups/:
    get:
      operationId: v1_catalog_otto_category_groups_list
      description: Returns OTTO category groups from the local JSON catalog. Without
        a suffix the response is German. Append /de/, /en/, /tr/, or /ru/; an unsupported
        suffix falls back to English.
      summary: List OTTO category groups
      parameters:
      - in: query
        name: limit
        schema:
          type: integer
      - in: query
        name: page
        schema:
          type: integer
      - in: query
        name: search
        schema:
          type: string
        description: Part of a category group name.
      tags:
      - OTTO - Catalog
      security:
      - jwtAuth: []
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/OttoCategoryGroup'
          description: ''
  /api/v1/catalog/otto/category-groups/{group_id}/attributes/:
    get:
      operationId: v1_catalog_otto_category_groups_attributes_list
      description: Returns attribute definitions for the selected group. Without a
        suffix the response is German. Append /de/, /en/, /tr/, or /ru/; an unsupported
        suffix falls back to English. HIGH, MEDIUM and LOW relevance values are used
        only to order the manager/mobile UI; all attributes are optional.
      summary: Get attributes for an OTTO category group
      parameters:
      - in: path
        name: group_id
        schema:
          type: integer
        required: true
      tags:
      - OTTO - Catalog
      security:
      - jwtAuth: []
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/OttoCategoryAttribute'
          description: ''
  /api/v1/catalog/otto/category-groups/{group_id}/attributes/{language}/:
    get:
      operationId: v1_catalog_otto_category_groups_attributes_list_2
      description: Returns attribute definitions for the selected group. Without a
        suffix the response is German. Append /de/, /en/, /tr/, or /ru/; an unsupported
        suffix falls back to English. HIGH, MEDIUM and LOW relevance values are used
        only to order the manager/mobile UI; all attributes are optional.
      summary: Get attributes for an OTTO category group
      parameters:
      - in: path
        name: group_id
        schema:
          type: integer
        required: true
      - in: path
        name: language
        schema:
          type: string
        required: true
      tags:
      - OTTO - Catalog
      security:
      - jwtAuth: []
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/OttoCategoryAttribute'
          description: ''
  /api/v1/catalog/otto/category-groups/{group_id}/categories/:
    get:
      operationId: v1_catalog_otto_category_groups_categories_list
      description: Returns selectable OTTO subcategories for one category group. Without
        a suffix the response is German. Append /de/, /en/, /tr/, or /ru/; an unsupported
        suffix falls back to English.
      summary: List categories in an OTTO group
      parameters:
      - in: path
        name: group_id
        schema:
          type: integer
        required: true
      - in: query
        name: limit
        schema:
          type: integer
      - in: query
        name: page
        schema:
          type: integer
      tags:
      - OTTO - Catalog
      security:
      - jwtAuth: []
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/OttoCategory'
          description: ''
  /api/v1/catalog/otto/category-groups/{group_id}/categories/{language}/:
    get:
      operationId: v1_catalog_otto_category_groups_categories_list_2
      description: Returns selectable OTTO subcategories for one category group. Without
        a suffix the response is German. Append /de/, /en/, /tr/, or /ru/; an unsupported
        suffix falls back to English.
      summary: List categories in an OTTO group
      parameters:
      - in: path
        name: group_id
        schema:
          type: integer
        required: true
      - in: path
        name: language
        schema:
          type: string
        required: true
      - in: query
        name: limit
        schema:
          type: integer
      - in: query
        name: page
        schema:
          type: integer
      tags:
      - OTTO - Catalog
      security:
      - jwtAuth: []
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/OttoCategory'
          description: ''
  /api/v1/catalog/otto/category-groups/{language}/:
    get:
      operationId: v1_catalog_otto_category_groups_list_2
      description: Returns OTTO category groups from the local JSON catalog. Without
        a suffix the response is German. Append /de/, /en/, /tr/, or /ru/; an unsupported
        suffix falls back to English.
      summary: List OTTO category groups
      parameters:
      - in: path
        name: language
        schema:
          type: string
        required: true
      - in: query
        name: limit
        schema:
          type: integer
      - in: query
        name: page
        schema:
          type: integer
      - in: query
        name: search
        schema:
          type: string
        description: Part of a category group name.
      tags:
      - OTTO - Catalog
      security:
      - jwtAuth: []
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/OttoCategoryGroup'
          description: ''
  /api/v1/catalog/otto/shipping-profiles/:
    get:
      operationId: v1_catalog_otto_shipping_profiles_list
      description: Returns selectable shipping profile names for JV or XL. The frontend
        displays only shipping_profile_name and keeps shipping_profile_id as a hidden
        technical value.
      summary: List OTTO shipping profiles for an account
      parameters:
      - in: query
        name: account
        schema:
          type: string
        description: 'OTTO account: jv or xl.'
        required: true
      tags:
      - OTTO - Delivery
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/OttoShippingProfile'
          description: ''
  /api/v1/manager/dashboard/:
    get:
      operationId: v1_manager_dashboard_retrieve
      description: 'Live overview counts for the manager home page: moderation queue,
        active marketplace listings, free EANs, and sellers.'
      summary: Получить сводку панели менеджера
      tags:
      - Manager moderation
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ManagerDashboard'
          description: ''
  /api/v1/manager/eans/:
    get:
      operationId: v1_manager_eans_list
      summary: Получить EAN-коды
      parameters:
      - name: page
        required: false
        in: query
        description: A page number within the paginated result set.
        schema:
          type: integer
      tags:
      - EAN pool
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedEanCodeList'
          description: ''
  /api/v1/manager/eans/import/:
    post:
      operationId: v1_manager_eans_import_create
      description: Applies manager mutation rate limiting to write HTTP methods only.
      summary: Импортировать EAN-коды
      tags:
      - EAN pool
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/EanImportRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/EanImportRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/EanImportRequest'
        required: true
      security:
      - jwtAuth: []
      responses:
        '201':
          content:
            application/json:
              schema:
                type: object
                additionalProperties: {}
          description: ''
  /api/v1/manager/eans/summary/:
    get:
      operationId: v1_manager_eans_summary_retrieve
      summary: Получить остаток EAN-кодов
      tags:
      - EAN pool
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                type: object
                additionalProperties: {}
          description: ''
  /api/v1/manager/products/:
    get:
      operationId: v1_manager_products_list
      summary: Получить товары для менеджера
      parameters:
      - name: page
        required: false
        in: query
        description: A page number within the paginated result set.
        schema:
          type: integer
      - name: page_size
        required: false
        in: query
        description: Number of results to return per page.
        schema:
          type: integer
      tags:
      - Manager moderation
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedProductsProductList'
          description: ''
  /api/v1/manager/products/{product_pk}/approve/:
    post:
      operationId: v1_manager_products_approve_create
      description: Applies manager mutation rate limiting to write HTTP methods only.
      summary: Одобрить товар и назначить EAN
      parameters:
      - in: path
        name: product_pk
        schema:
          type: integer
        required: true
      tags:
      - Manager moderation
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/ModerationApproveRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/ModerationApproveRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/ModerationApproveRequest'
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ProductsProduct'
          description: ''
  /api/v1/manager/products/{product_pk}/availability-request/:
    post:
      operationId: v1_manager_products_availability_request_create
      description: Applies manager mutation rate limiting to write HTTP methods only.
      summary: Запросить подтверждение наличия
      parameters:
      - in: path
        name: product_pk
        schema:
          type: integer
        required: true
      tags:
      - Manager moderation
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ProductsProduct'
          description: ''
  /api/v1/manager/products/{product_pk}/deactivate/:
    post:
      operationId: v1_manager_products_deactivate_create
      description: Legacy shortcut that deactivates every active listing of a product.
        Use the orchestrator listing-state endpoint to choose targets.
      summary: Отключить все активные публикации
      parameters:
      - in: path
        name: product_pk
        schema:
          type: integer
        required: true
      tags:
      - Manager moderation
      security:
      - jwtAuth: []
      responses:
        '202':
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/MarketplaceJob'
          description: ''
