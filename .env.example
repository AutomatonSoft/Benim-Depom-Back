DJANGO_ENV=production
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=ОТДЕЛЬНЫЙ_ДЛИННЫЙ_СЛУЧАЙНЫЙ_СЕКРЕТ
DJANGO_ALLOWED_HOSTS=stage.benim.automatonsoft.de
CORS_ALLOWED_ORIGINS=https://stage.benim.automatonsoft.de
CSRF_TRUSTED_ORIGINS=https://stage.benim.automatonsoft.de

POSTGRES_DB=benim_depom_stage
POSTGRES_USER=benim_depom_stage
POSTGRES_PASSWORD=ОТДЕЛЬНЫЙ_СИЛЬНЫЙ_ПАРОЛЬ
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Optional recipient for new product and verified seller notifications.
PRODUCT_CREATE_EMAIL=
PUBLIC_BASE_URL=https://stage.benimdepom.info
REDIS_CACHE_URL=redis://redis:6379/2

FIREBASE_ENABLED=false
FIREBASE_SERVICE_ACCOUNT_FILE=/run/secrets/firebase-service-account.json

OPENAI_ENABLED=false

# Sentry (same DSN as production; environment must stay staging)
SENTRY_DSN=
SENTRY_ENVIRONMENT=staging
SENTRY_TRACES_SAMPLE_RATE=0.1

# eBay: stage/local use Sandbox credentials; Production uses its own credentials.
EBAY_ENVIRONMENT=sandbox
EBAY_PUBLIC_BASE_URL=https://stage.benimdepom.info
EBAY_SANDBOX_APP_ID=
EBAY_SANDBOX_DEV_ID=
EBAY_SANDBOX_CERT_ID=
EBAY_RUNAME=
EBAY_TOKEN_ENCRYPTION_KEY=
EBAY_NOTIFICATION_VERIFICATION_TOKEN=

